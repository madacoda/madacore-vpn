# WireGuard General Settings
WG_PORT=51820
TZ=Etc/UTC

# Server Public IP or Domain (Used for Client Configuration)
# Note: GitHub Actions or server setup will write this dynamically, or you can specify it
SERVER_URL=your-vps-ip-here

# Default peers count for container initial start
CLIENTS_COUNT=1
PEER_DNS=1.1.1.1,8.8.8.8

# Monitoring & Account Dashboard Configuration
# Use 127.0.0.1 for local/SSH tunnel security, or 0.0.0.0 to access directly via public IP:10000
MONITOR_BIND=127.0.0.1
MONITOR_PORT=10000
